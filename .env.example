# ---------------------------------------------------------------- app secrets
# Signs the onboarding session cookie. Required in production.
SESSION_SECRET=change-me
# Peppers the verification-code hashes. Rotating it invalidates codes in flight.
VERIFICATION_SECRET=change-me

# -------------------------------------------------------------------- storage
# SQLite file. Serverless filesystems are ephemeral — point this at a mounted
# volume, or implement the Store interface against Postgres (sql/postgres.sql).
DATABASE_FILE=data/onboarding.sqlite

# ----------------------------------------------------------------------- mail
# Without this the verification code is logged to the server console instead.
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=Vista <onboarding@kovara.ai>

# ------------------------------------------------------------------ pipedrive
# Server-side only. The onboarding page must never hold this.
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_BASE_URL=https://api.pipedrive.com

# Printed by: node --experimental-strip-types scripts/pipedrive-setup.ts
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_FIELD_AMS_NAME=
PIPEDRIVE_FIELD_AMS_STATUS=
PIPEDRIVE_FIELD_NPN=
PIPEDRIVE_FIELD_RESIDENT_STATE=
PIPEDRIVE_FIELD_BOOK_SIZE_EST=
PIPEDRIVE_FIELD_UTM_CONTENT=

# ------------------------------------------------------------- ops endpoints
# Bearer tokens for POST /api/jobs/run and GET /api/reports/ams-demand.
JOBS_RUN_SECRET=
REPORTS_SECRET=
