# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── Meta Ads (.claude/skills/meta-ad-builder) ────────────────────────────────
# Token needs the ads_management scope. Every ad the skill creates is PAUSED —
# you launch manually in Ads Manager.
META_ACCESS_TOKEN=your_long_lived_token_here
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
META_IG_USER_ID=
META_PIXEL_ID=
META_API_VERSION=v23.0
