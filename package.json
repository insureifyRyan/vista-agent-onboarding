{
  "name": "vista-agent-onboarding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "jobs:work": "node --experimental-strip-types scripts/work-jobs.mts",
    "pipedrive:fields": "node --experimental-strip-types scripts/pipedrive-fields.mts",
    "links:check": "node --experimental-strip-types scripts/check-links.mts",
    "pipedrive:setup": "node --experimental-strip-types scripts/pipedrive-setup.mts"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
